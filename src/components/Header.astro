---

---

<header class='fixed top-0 left-0 w-full z-50 p-6 md:px-12 pointer-events-none' style='z-index: 200 !important;'>
  <!-- Desktop Nav -->
  <div class='max-container hidden md:flex justify-center items-center pointer-events-auto'>
    <nav class='bg-white/80 backdrop-blur py-2 px-6 gap-6 flex flex-row rounded-full text-[18px] font-[400] shadow-sm'>
      <a href='#about' class='header-menu pen-underline hover-about transition-colors'>about</a>
      <a href='#projects' class='header-menu pen-underline hover-project transition-colors'>work</a>
      <a href='#workflow' class='header-menu pen-underline hover-workflow transition-colors'>workflow</a>
      <a href='#contact' class='header-menu pen-underline hover-contact transition-colors'>contact</a>
      <a href='#resume' class='header-menu pen-underline hover-resume transition-colors'>resume</a>
    </nav>
  </div>

  <!-- Mobile Nav -->
  <div class='flex md:hidden flex-col items-center gap-[10px] pointer-events-auto'>
    <!-- Header Pill -->
    <div
      class='w-full flex justify-between items-center bg-white/90 backdrop-blur py-[6px] px-[20px] rounded-full shadow-sm max-w-[400px] max-h-9'
    >
      <span class='font-script text-[20px] select-none text-black'>Nanthakan R.</span>
      <button
        id='mobile-menu-toggle'
        class='flex flex-col gap-[6px] justify-center items-center w-6 h-6 relative focus:outline-none'
        aria-label='Toggle menu'
      >
        <span class='line-1 w-4 h-[2px] bg-black transition-all duration-300 transform'></span>
        <span class='line-2 w-4 h-[2px] bg-black transition-all duration-300 transform'></span>
      </button>
    </div>

    <!-- Menu Card -->
    <div
      id="mobile-menu-card"
      class="w-full bg-white/90 backdrop-blur rounded-[16px] shadow-sm max-w-[400px] transition-all duration-300 ease-in-out opacity-0 translate-y-[-10px] pointer-events-none grid grid-rows-[0fr]"
    >
      <div class="overflow-hidden flex flex-col items-center gap-[20px] px-6 py-4">
        <a
          href="#about"
          class="mobile-menu-link text-[14px] font-normal text-black"
          >about</a
        >
        <a
          href="#projects"
          class="mobile-menu-link text-[14px] font-normal text-black">work</a
        >
        <a
          href="#workflow"
          class="mobile-menu-link text-[14px] font-normal text-black"
          >workflow</a
        >
        <a
          href="#contact"
          class="mobile-menu-link text-[14px] font-normal text-black">contact</a
        >
        <a
          href="#resume"
          class="mobile-menu-link text-[14px] font-normal text-black"
          >resume</a
        >
      </div>
    </div>
  </div>

  <style>
    /* Desktop Hover Effects */
    .pen-underline {
      position: relative;
    }
    .hover-about,
    .hover-project,
    .hover-workflow,
    .hover-contact,
    .hover-resume {
      position: relative;
    }
    .hover-about::after {
      content: '';
      position: absolute;
      inset: 0;
      background: url('/portfolio/assets/hover/hover-about.png') bottom/contain no-repeat;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      translate: 0 4px;
    }
    .hover-project:hover::after {
      content: '';
      position: absolute;
      inset: 0;
      background: url('/portfolio/assets/hover/hover-work.png') bottom/contain no-repeat;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      translate: 0 4px;
    }
    .hover-workflow:hover::after {
      content: '';
      position: absolute;
      inset: 0;
      background: url('/portfolio/assets/hover/hover-workflow.png') bottom/contain no-repeat;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      translate: 0 4px;
    }
    .hover-contact:hover::after {
      content: '';
      position: absolute;
      inset: 0;
      background: url('/portfolio/assets/hover/hover-contact.png') bottom/contain no-repeat;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      translate: 0 4px;
    }
    .hover-resume:hover::after {
      content: '';
      position: absolute;
      inset: 0;
      background: url('/portfolio/assets/hover/hover-resume.png') bottom/contain no-repeat;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      translate: 0 4px;
    }

    .hover-project:hover::after,
    .hover-about:hover::after,
    .hover-workflow:hover::after,
    .hover-contact:hover::after,
    .hover-resume:hover::after {
      opacity: 1;
    }

    /* Hamburger Animation */
    button.is-open .line-1 {
      transform: translateY(4px) rotate(45deg);
    }
    button.is-open .line-2 {
      transform: translateY(-4px) rotate(-45deg);
    }

    /* Mobile Menu Card Animation */
    #mobile-menu-card.is-open {
      opacity: 1;
      translate: 0 0;
      pointer-events: auto;
      grid-template-rows: 1fr;
    }

    .header-menu {
      line-height: 22px;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .mobile-menu-link {
      cursor: pointer;
      width: 100%;
      text-align: center;
    }
  </style>
</header>

<script>
  function setupMobileMenu() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu-card');
    const links = document.querySelectorAll('.mobile-menu-link');

    if (!toggle || !menu) return;

    const toggleMenu = () => {
      const isOpen = toggle.classList.toggle('is-open');
      menu.classList.toggle('is-open');

      if (isOpen) {
        // Prevent body scroll when menu is open? Optional but good for UX
        // document.body.style.overflow = 'hidden';
      } else {
        // document.body.style.overflow = '';
      }
    };

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Close when clicking a link
    links.forEach((link) => {
      link.addEventListener('click', () => {
        if (toggle.classList.contains('is-open')) {
          toggleMenu();
        }
      });
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node) && !toggle.contains(e.target as Node)) {
        if (toggle.classList.contains('is-open')) {
          toggleMenu();
        }
      }
    });
  }

  // Run on initial load and view transitions
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
