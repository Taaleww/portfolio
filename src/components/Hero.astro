---
import { Image } from 'astro:assets';
import bgHero from '../assets/bg-hero.jpg';
import nameHero from '../assets/name-hero.svg';
---

<section class='relative min-h-screen flex flex-col justify-end pb-5 lg:pb-6 px-[20px] lg:px-[40px] overflow-hidden'>
  <!-- Background Image -->
  <div class='absolute inset-0 -z-10 bg-white'>
    <Image
      src={bgHero}
      alt='Hero Background'
      class='w-full h-full object-cover scale-[1.5] absolute top-[20%] left-[25%]'
      quality='high'
    />
    <!-- Optional: Gradient overlay to ensure text readability at the bottom -->
    <div class='absolute inset-0 bg-gradient-to-t from-white/40 via-transparent to-transparent'></div>
  </div>
  <div class='flex flex-col items-start'>
    <div class='flex flex-col items-end gap-[62px] w-full mb-[32px] md:mb-[52px]'>
      <div class='flex justify-end'>
        <div
          class='flex flex-col space-y-2 text-left text-[16px] lg:text-[24px] font-[400] text-black mr-[5dvw] lg:mr-[10dvw] font-script'
        >
          <a class='hover:text-black transition-colors'>UX/UI Designer</a>
          <a class='hover:text-black transition-colors'>Wireframing & Prototyping</a>
          <a class='hover:text-black transition-colors'>Design Skill</a>
          <a class='hover:text-black transition-colors'>Basic Coding</a>
        </div>
      </div>
      <div class='w-full items-start space-y-6'>
        <div class='text-[16px] lg:text-[24px] font-[400] text-black'>©2026</div>
        <p class='text-[16px] lg:text-[24px] font-[400] leading-[160%] text-black max-w-[620px]'>
          Meet your trusted UX/UI design , crafting intuitive and impactful digital experiences.
        </p>
      </div>
    </div>

    <div class='page-fade-in'>
      <!-- <Image src={nameHero} alt='Hero Title' class='w-full h-full object-cover' quality='high' /> -->
      <h1
        class='text-[14.2dvw] tracking-tighter text-black select-none leading-none !h-min flex items-end gap-0'
        style='color: rgba(42, 37, 37, 0.9); letter-spacing: 1%;'
      >
        <div class='ml-[-1dvw] leading-[75%]'>Na</div>
        <div class='leading-[75%]'>nt</div>
        <div class='leading-[75%]'>ha</div>
        <div class='leading-[75%]'>kan</div>
        <div class='ml-[3dvw] md:ml-[5dvw] lg:ml-[6dvw] leading-[75%]'>R.</div>
      </h1>
    </div>
  </div>
</section>
