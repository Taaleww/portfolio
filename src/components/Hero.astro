---
import { Image } from "astro:assets";
import bgHero from "../assets/bg-hero.jpg";
import nameHero from "../assets/name-hero.svg";
import hover01 from "../assets/hover/hover-01.png";
import hover02 from "../assets/hover/hover-02.png";
import hover03 from "../assets/hover/hover-03.png";
import hover04 from "../assets/hover/hover-04.png";
import hover05 from "../assets/hover/hover-05.png";
---

<section
  class="relative min-h-screen flex flex-col justify-end pb-5 lg:pb-6 px-[20px] lg:px-[40px] overflow-hidden"
>
  <!-- Background Image -->
  <div class="absolute inset-0 -z-10 bg-white">
    <Image
      src={bgHero}
      alt="Hero Background"
      class="w-full h-full object-cover scale-[1.5] absolute top-[20%] left-[25%]"
      quality="high"
    />
    <!-- Optional: Gradient overlay to ensure text readability at the bottom -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-white/40 via-transparent to-transparent"
    >
    </div>
  </div>
  <div class="flex flex-col items-start">
    <div
      class="flex flex-col items-end gap-[62px] w-full mb-[32px] md:mb-[52px]"
    >
      <div class="flex justify-end">
        <div
          class="flex flex-col space-y-2 text-left text-[16px] lg:text-[24px] font-[400] text-black mr-[5dvw] lg:mr-[10dvw] font-script"
        >
          <a class="hover:text-black transition-colors">UX/UI Designer</a>
          <a class="hover:text-black transition-colors"
            >Wireframing & Prototyping</a
          >
          <a class="hover:text-black transition-colors">Design Skill</a>
          <a class="hover:text-black transition-colors">Basic Coding</a>
        </div>
      </div>
      <div class="w-full items-start space-y-2">
        <div class="text-[16px] lg:text-[24px] font-[400] text-black">
          ©2026
        </div>
        <p
          class="text-[16px] lg:text-[24px] font-[400] leading-[160%] text-black max-w-[620px]"
        >
          Designing intuitive digital experiences through thoughtful UX and
          clean interfaces.
        </p>
      </div>
    </div>

    <div class="page-fade-in">
      <!-- <Image src={nameHero} alt='Hero Title' class='w-full h-full object-cover' quality='high' /> -->
      <h1
        class="text-[14.2dvw] tracking-tighter text-black select-none leading-none !h-min flex items-end gap-0 overflow-visible"
        style="color: rgba(0, 0, 0); letter-spacing: 1%;"
      >
        <!-- Na -->
        <div
          class="relative group ml-[-1dvw] leading-[75%] cursor-pointer overflow-visible"
        >
          <span class="relative z-10">Na</span>
          <div
            class="overflow-visible absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[160%] h-[160%] object-cover opacity-0 translate-y-40 group-hover:opacity-100 group-hover:translate-y-[-96px] transition-all duration-500 ease-out pointer-events-none z-30"
          >
            <Image
              src={hover01}
              alt="Na hover"
              class="w-full h-full object-contain mt-[-50px]"
              quality="high"
            />
          </div>
        </div>

        <!-- nt -->
        <div
          class="relative group leading-[75%] cursor-pointer overflow-visible"
        >
          <span class="relative z-10">nt</span>
          <div
            class="overflow-visible absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[100%] h-[100%] object-cover opacity-0 translate-y-40 group-hover:opacity-100 group-hover:translate-y-[-60px] transition-all duration-500 ease-out pointer-events-none z-30"
          >
            <Image
              src={hover02}
              alt="nt hover"
              class="w-full h-full object-contain"
              quality="high"
            />
          </div>
        </div>

        <!-- ha -->
        <div
          class="relative group leading-[75%] cursor-pointer overflow-visible"
        >
          <span class="relative z-10">ha</span>
          <div
            class="overflow-visible absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[160%] h-[160%] object-cover opacity-0 translate-y-40 group-hover:opacity-100 group-hover:translate-y-[-96px] transition-all duration-500 ease-out pointer-events-none z-30"
          >
            <Image
              src={hover03}
              alt="ha hover"
              class="w-full h-full object-contain mt-[-40px]"
              quality="high"
            />
          </div>
        </div>

        <!-- kan -->
        <div
          class="relative group leading-[75%] cursor-pointer overflow-visible"
        >
          <span class="relative z-10">kan</span>
          <div
            class="overflow-visible absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[160%] h-[160%] object-cover opacity-0 translate-y-40 group-hover:opacity-100 group-hover:translate-y-[-96px] transition-all duration-500 ease-out pointer-events-none z-30"
          >
            <Image
              src={hover04}
              alt="kan hover"
              class="w-full h-full object-contain mt-[-50px]"
              quality="high"
            />
          </div>
        </div>

        <!-- R. -->
        <div
          class="relative group ml-[3dvw] md:ml-[5dvw] lg:ml-[6dvw] leading-[75%] cursor-pointer overflow-visible"
        >
          <span class="relative z-10">R.</span>
          <div
            class="overflow-visible absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[160%] h-[160%] object-cover opacity-0 translate-y-40 group-hover:opacity-100 group-hover:translate-y-[-96px] transition-all duration-500 ease-out pointer-events-none z-30"
          >
            <Image
              src={hover05}
              alt="R. hover"
              class="w-full h-full object-contain mt-[-40px]"
              quality="high"
            />
          </div>
        </div>
      </h1>
    </div>
  </div>
</section>
