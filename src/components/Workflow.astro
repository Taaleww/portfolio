---
const steps = [
  {
    number: "01",
    title: "Discovery",
    description: "Every new project, I begin by learning about your needs, audience, and problem to understand what matters most and define the right direction for the project.",
    color: "#F3EAD3",
    rotation: "-11.44deg",
    mobile_rotation: "3.03deg",
    yOffset: "0px"
  },
  {
    number: "02",
    title: "Research",
    description: "Before designing, I dive into research to understand user behavior, industry trends, and competitors. This helps uncover opportunities and create solutions based on real insights.",
    color: "#F5D6A4",
    rotation: "11.24deg",
    mobile_rotation: "-6.2deg",
    yOffset: "0.41px"
  },
  {
    number: "03",
    title: "UI Design",
    description: "I transform ideas into intuitive and visually refined experiences. From user flow to interface details, every element is designed to feel clear, engaging, and aligned with your brand.",
    color: "#D6E9EF",
    rotation: "-11deg",
    mobile_rotation: "3.03deg",
    yOffset: "0.91px"
  },
  {
    number: "04",
    title: "Handoff & Quality Assurance",
    description: "After the UX/UI process, I collaborate with developers through clear handoff and discussions to ensure the final design stays true to the design vision and user journey.",
    color: "#E2EBD3",
    rotation: "9.66deg",
    mobile_rotation: "-6.07deg",
    yOffset: "3.77px"
  }
];
---

<section id="workflow" class="py-32 px-6 md:px-12 lg:px-24 overflow-visible bg-white">
  <div class="max-container flex flex-col items-center">
    <!-- Header -->
    <div class="text-center mb-24 max-w-2xl">
      <div class="relative inline-block mb-6">
        <h2 class="text-5xl md:text-[64px] font-black tracking-tight uppercase relative z-10 text-black leading-none">
          MY <span class="relative inline-block">
            <span class="relative z-10">WORKFLOW</span>
            <div class="absolute top-[-8px] z-1 pointer-events-none">
            <svg width="384" height="72" viewBox="0 0 384 72" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M234.89 6.56935C178.151 7.12227 121.413 7.6752 89.2046 8.64513C40.1301 10.123 24.7853 21.0779 14.535 28.5985C5.44828 35.2654 1.96417 45.184 1.50389 53.1777C1.40204 54.9466 3.37991 56.1464 5.48333 57.3595C7.58675 58.5726 10.505 59.6744 32.0387 62.149C53.5724 64.6236 93.6332 68.4375 140.057 69.8534C186.481 71.2692 238.055 70.1715 273.661 68.378C309.266 66.5846 327.342 64.1287 339.718 61.8929C368.906 56.6202 377.154 48.4191 380.517 44.7736C382.214 42.9345 383.047 40.5711 382.108 37.0099C381.168 33.4488 378.216 28.6218 371.258 24.5148C364.3 20.4078 353.426 17.1669 333.572 13.5561C313.717 9.94534 285.21 6.06279 266.633 3.96986C248.055 1.87693 240.272 1.69128 232.253 1.5" stroke="#8AE2E6" stroke-width="3" stroke-linecap="round"/>
            </svg>
            </div>
          </span>
        </h2>
      </div>
      <div class="text-[14px] text-[#888888] font-normal mt-4 max-w-[500px]">
        <p>A thoughtful process creates meaningful results.</p>
        <p>My workflow helps transform ideas into intuitive and impactful user experiences.</p>
      </div>
    </div>

    <!-- Cards Container with Responsive Overlap -->
    <div class="relative w-full max-w-[1400px] mt-12 mb-20 flex flex-wrap justify-center lg:flex-nowrap lg:px-4">
      {steps.map((step, index) => (
        <div 
          class="card-note relative p-6 xl:p-7 w-[280px] h-[280px] lg:w-[240px] lg:h-[240px] xl:w-[300px] xl:h-[300px] transition-all duration-300 cursor-default flex-shrink-0 lg:mb-0 lg:-mr-12 xl:-mr-10"
          style={`background-color: ${step.color}; --base-rotation: ${step.rotation}; --mobile-rotation: ${step.mobile_rotation}; --base-y: ${step.yOffset}; z-index: ${index};`}
        >
          <!-- Horizontal Lines Pattern (Sticky Note feel) - Adjusted to not hit edges -->
          <div class="absolute left-6 right-6 top-8 bottom-8 opacity-10 pointer-events-none" style="background-image: linear-gradient(#000 1px, transparent 1px); background-size: 100% 26px;"></div>
          
          <div class="relative z-10 h-full flex flex-col justify-between mt-[-10px]">
            <div class="flex flex-col">
              <span class="font-script font-normal text-[64px] italic text-black leading-[100%]">{step.number}</span>
              <h3 class="font-script text-[28px] font-normal leading-[100%] text-black">{step.title}</h3>
            </div>
            <p class="text-[14px] leading-[1.5] text-black/80 font-sans" style="font-weight: 400;font-size: 10px;line-height: 140%;letter-spacing: 1%;
">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Ensure fonts are loaded if not global */
  @import url('https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&display=swap');
  
  .font-script {
    font-family: 'Caveat', cursive;
  }

  .card-note {
    transform: rotate(var(--mobile-rotation)) translateY(var(--base-y));
    box-shadow: 2px 8px 25px rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 1024px) {
    .card-note {
      transform: rotate(var(--base-rotation)) translateY(var(--base-y));
    }
  }

  .card-note:hover {
    transform: rotate(0deg) translateY(0px) scale(1.1) !important;
    z-index: 100 !important;
    box-shadow: 0px 20px 40px rgba(0, 0, 0, 0.12);
  }
</style>
