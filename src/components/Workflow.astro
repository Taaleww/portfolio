---
import { Image } from 'astro:assets';
import circleDraw from '../assets/circle-draw.svg';

const steps = [
  {
    number: "01",
    title: "Discovery",
    description: "Understanding goals, users, and business needs",
    color: "#F3EAD3",
    rotation: "11.44deg",
    mobile_rotation: "3.03deg",
    yOffset: "0px"
  },
  {
    number: "02",
    title: "Research",
    description: "Exploring insights, competitors, and opportunities.",
    color: "#F5D6A4",
    rotation: "-11.24deg",
    mobile_rotation: "-6.2deg",
    yOffset: "0.41px"
  },
  {
    number: "03",
    title: "UI Design",
    description: "Crafting intuitive and visually refined experiences.",
    color: "#D6E9EF",
    rotation: "11deg",
    mobile_rotation: "3.03deg",
    yOffset: "0.91px"
  },
  {
    number: "04",
    title: "Handoff & Quality Assurance",
    description: "Collaborating with developers for seamless implementation.",
    color: "#E2EBD3",
    rotation: "-9.66deg",
    mobile_rotation: "-6.07deg",
    yOffset: "3.77px"
  }
];
---

<section id="workflow" class="pt-[80px] md:pt-[120px] pb-[100px] md:pb-[160px] px-6 md:px-12 lg:px-24 overflow-visible bg-white">
  <div class="max-container flex flex-col items-center">
    <!-- Header -->
    <div class="text-center mb-[40px] md:mb-[100px] max-w-2xl" data-animate="fade-up">
      <div class="relative inline-block mb-6">
        <h2 class="text-[36px] md:text-[64px] font-black tracking-tight uppercase relative z-10 text-black leading-none">
          MY <span class="relative inline-block">
            <span class="relative z-10">WORKFLOW</span>
             <!-- Hand-drawn Teal Loop -->
            <Image
              src={circleDraw}
              alt='circle draw'
              class='absolute top-1/2 left-1/2 w-[110%] min-w-[120px] h-auto max-w-none -translate-x-1/2 -translate-y-1/2 -z-0 pointer-events-none'
            />
          </span>
        </h2>
      </div>
      <div class="text-[14px] text-[#888888] font-normal max-w-[500px] letter-spacing-[1%]">
        <p>A thoughtful process creates meaningful results.</p>
        <p>My workflow helps transform ideas into intuitive and impactful user experiences.</p>
      </div>
    </div>

    <!-- Cards Container with Responsive Overlap -->
    <div class="relative w-full max-w-[1400px] flex flex-wrap justify-center lg:flex-nowrap lg:px-4">
      {steps.map((step, index) => (
        <div data-animate="fade-up" data-delay={index * 100} class="flex-shrink-0 lg:mb-0 lg:-mr-12 xl:-mr-10 relative mb-4 lg:mb-0" style={`z-index: ${index};`}>
          <div 
            class="card-note relative p-6 xl:p-7 w-[280px] h-[280px] lg:w-[240px] lg:h-[240px] xl:w-[300px] xl:h-[300px] transition-all duration-300 cursor-default"
            style={`background-color: ${step.color}; --base-rotation: ${step.rotation}; --mobile-rotation: ${step.mobile_rotation}; --base-y: ${step.yOffset};`}
          >
          <!-- Horizontal Lines Pattern (Sticky Note feel) - Adjusted to not hit edges -->
          <div class="absolute left-6 right-6 top-8 bottom-8 opacity-10 pointer-events-none" style="background-image: linear-gradient(#000 1px, transparent 1px); background-size: 100% 26px;"></div>
          
          <div class="relative z-10 h-full flex flex-col justify-between mt-[-10px]">
            <div class="flex flex-col">
              <span class="font-script font-normal text-[64px] italic text-black leading-[100%]">{step.number}</span>
              <h3 class="font-script text-[28px] font-normal leading-[100%] text-black">{step.title}</h3>
            </div>
            <p class="text-[14px] leading-[1.5] text-black/80 font-sans" style="font-weight: 400;font-size: 16px;line-height: 140%;letter-spacing: 1%;
">
              {step.description}
            </p>
          </div>
        </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .card-note {
    transform: rotate(var(--mobile-rotation)) translateY(var(--base-y));
    box-shadow: 2px 8px 25px rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 1024px) {
    .card-note {
      transform: rotate(var(--base-rotation)) translateY(var(--base-y));
    }
  }

  .card-note:hover {
    transform: rotate(0deg) translateY(0px) scale(1.1) !important;
    z-index: 100 !important;
    box-shadow: 0px 20px 40px rgba(0, 0, 0, 0.12);
  }
</style>
