<!-- src/components/Lightbox.astro -->
<div
  id='lightbox'
  class='fixed inset-0 z-[9999] bg-black/95 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 flex flex-col justify-between p-4 md:p-8'
  role='dialog'
  aria-modal='true'
>
  <!-- Top bar (Close button & Counter) -->
  <div class='flex justify-between items-center w-full z-20 select-none'>
    <div
      id='lightbox-counter'
      class='text-white/60 font-sans text-sm md:text-base font-light tracking-wide bg-black/35 backdrop-blur py-1.5 px-4 rounded-full border border-white/5'
    >
      Image 1 of 5
    </div>

    <!-- Close Button -->
    <button
      id='lightbox-close'
      class='text-white/80 hover:text-white bg-white/10 hover:bg-white/20 transition-all duration-300 p-2.5 md:p-3 rounded-full cursor-pointer touch-manipulation focus:outline-none flex items-center justify-center'
      aria-label='Close lightbox'
    >
      <svg
        width='24'
        height='24'
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2'
        stroke-linecap='round'
        stroke-linejoin='round'
      >
        <line x1='18' y1='6' x2='6' y2='18'></line>
        <line x1='6' y1='6' x2='18' y2='18'></line>
      </svg>
    </button>
  </div>

  <!-- Main content area (Container for image + Navigation) -->
  <div class='relative flex-grow flex items-center justify-center w-full min-h-0 select-none'>
    <!-- Prev button -->
    <button
      id='lightbox-prev'
      class='absolute left-2 md:left-4 z-10 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 transition-all duration-200 p-3 rounded-full cursor-pointer touch-manipulation focus:outline-none flex items-center justify-center'
      aria-label='Previous image'
    >
      <svg class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2.5'>
        <path stroke-linecap='round' stroke-linejoin='round' d='M15 19l-7-7 7-7'></path>
      </svg>
    </button>

    <!-- Zoomable Image wrapper -->
    <div id='lightbox-viewport' class='w-full h-full flex items-center justify-center overflow-hidden p-2 relative'>
      <img
        id='lightbox-img'
        src=''
        alt='Enlarged Project Screen'
        class='max-w-[95%] max-h-[75vh] md:max-h-[78vh] object-contain rounded-lg shadow-2xl transition-transform cursor-zoom-in'
        draggable='false'
      />
    </div>

    <!-- Next button -->
    <button
      id='lightbox-next'
      class='absolute right-2 md:right-4 z-10 text-white/70 hover:text-white bg-white/10 hover:bg-white/20 transition-all duration-200 p-3 rounded-full cursor-pointer touch-manipulation focus:outline-none flex items-center justify-center'
      aria-label='Next image'
    >
      <svg class='h-6 w-6' fill='none' viewBox='0 0 24 24' stroke='currentColor' stroke-width='2.5'>
        <path stroke-linecap='round' stroke-linejoin='round' d='M9 5l7 7-7 7'></path>
      </svg>
    </button>
  </div>

  <!-- Floating Zoom controls panel at the bottom center -->
  <div
    id='lightbox-zoom-panel'
    class='absolute bottom-3 md:bottom-4 left-1/2 -translate-x-1/2 z-20 flex items-center gap-1.5 bg-black/60 backdrop-blur-md py-1 px-2.5 rounded-full border border-white/15 shadow-xl select-none'
  >
    <!-- Zoom Out -->
    <button
      id='lightbox-zoom-out'
      class='text-white/70 hover:text-white hover:bg-white/10 disabled:opacity-30 disabled:hover:bg-transparent disabled:pointer-events-none transition-all duration-200 p-2 rounded-full cursor-pointer focus:outline-none flex items-center justify-center'
      aria-label='Zoom out'
    >
      <svg
        width='18'
        height='18'
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2.5'
        stroke-linecap='round'
        stroke-linejoin='round'
      >
        <circle cx='11' cy='11' r='8'></circle>
        <line x1='21' y1='21' x2='16.65' y2='16.65'></line>
        <line x1='8' y1='11' x2='14' y2='11'></line>
      </svg>
    </button>

    <!-- Zoom indicator -->
    <span
      id='lightbox-zoom-level'
      class='text-white/80 text-xs md:text-sm font-mono font-medium px-2 select-none min-w-[46px] text-center'
    >
      100%
    </span>

    <!-- Zoom In -->
    <button
      id='lightbox-zoom-in'
      class='text-white/70 hover:text-white hover:bg-white/10 disabled:opacity-30 disabled:hover:bg-transparent disabled:pointer-events-none transition-all duration-200 p-2 rounded-full cursor-pointer focus:outline-none flex items-center justify-center'
      aria-label='Zoom in'
    >
      <svg
        width='18'
        height='18'
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2.5'
        stroke-linecap='round'
        stroke-linejoin='round'
      >
        <circle cx='11' cy='11' r='8'></circle>
        <line x1='21' y1='21' x2='16.65' y2='16.65'></line>
        <line x1='11' y1='8' x2='11' y2='14'></line>
        <line x1='8' y1='11' x2='14' y2='11'></line>
      </svg>
    </button>

    <!-- Vertical Divider -->
    <span class='h-4 w-[1px] bg-white/20 mx-1'></span>

    <!-- Reset/Actual Zoom -->
    <button
      id='lightbox-zoom-reset'
      class='text-white/70 hover:text-white hover:bg-white/10 disabled:opacity-30 disabled:hover:bg-transparent disabled:pointer-events-none transition-all duration-200 p-2 rounded-full cursor-pointer focus:outline-none flex items-center justify-center'
      aria-label='Reset zoom'
    >
      <svg
        width='18'
        height='18'
        viewBox='0 0 24 24'
        fill='none'
        stroke='currentColor'
        stroke-width='2.5'
        stroke-linecap='round'
        stroke-linejoin='round'
      >
        <path d='M15 3h6v6'></path>
        <path d='M9 21H3v-6'></path>
        <path d='M21 3l-7 7'></path>
        <path d='M3 21l7-7'></path>
      </svg>
    </button>
  </div>

  <!-- Bottom spacer -->
  <div class='h-8 md:h-12 w-full'></div>
</div>

<style>
  /* Lightbox Image Hardware-Accelerated Transition (default view) */
  #lightbox-img {
    will-change: opacity, transform;
    opacity: 0;
    transform: scale(0.96) translate3d(0, 0, 0);
  }
</style>

<script>
  let keydownHandler: any = null;

  function initLightbox() {
    // Clean up keydown listener if configured
    if (keydownHandler) {
      document.removeEventListener('keydown', keydownHandler);
      keydownHandler = null;
    }

    const triggers = document.querySelectorAll('.lightbox-trigger');
    const lightbox = document.getElementById('lightbox');
    const lightboxViewport = document.getElementById('lightbox-viewport');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');
    const lightboxCounter = document.getElementById('lightbox-counter');

    // Zoom control buttons
    const zoomInBtn = document.getElementById('lightbox-zoom-in');
    const zoomOutBtn = document.getElementById('lightbox-zoom-out');
    const zoomResetBtn = document.getElementById('lightbox-zoom-reset');
    const zoomLevelEl = document.getElementById('lightbox-zoom-level');

    if (!lightbox || !lightboxImg || !triggers.length) return;

    // Save to non-nullable local variable for nested function scopes
    const lightboxEl = lightbox;

    // Collect all image sources
    const imgList: string[] = [];
    triggers.forEach((trigger) => {
      const img = trigger.querySelector('img');
      if (img && img.src) {
        imgList.push(img.src);
      }
    });

    let currentIndex = 0;

    // Zoom variables
    let zoomLevel = 1.0;
    let panX = 0;
    let panY = 0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;

    const ZOOM_STEP = 0.5;
    const MAX_ZOOM = 5.0;
    const MIN_ZOOM = 1.0;

    function applyTransform(withTransition = false) {
      if (withTransition) {
        // smooth ease out transition when resetting or stepping
        lightboxImg.style.transition =
          'opacity 0.25s cubic-bezier(0.25, 1, 0.5, 1), transform 0.25s cubic-bezier(0.25, 1, 0.5, 1)';
      } else {
        // disable transition for 60fps dragging / wheel zooming
        lightboxImg.style.transition = 'opacity 0.25s cubic-bezier(0.25, 1, 0.5, 1), transform 0s';
      }
      lightboxImg.style.transform = `translate3d(${panX}px, ${panY}px, 0) scale(${zoomLevel})`;
    }

    function clampPan() {
      const container = lightboxViewport || lightboxImg.parentElement;
      if (!container) return;

      const containerWidth = container.clientWidth;
      const containerHeight = container.clientHeight;

      const imgWidth = lightboxImg.offsetWidth * zoomLevel;
      const imgHeight = lightboxImg.offsetHeight * zoomLevel;

      const maxPanX = Math.max(0, (imgWidth - containerWidth) / 2);
      const maxPanY = Math.max(0, (imgHeight - containerHeight) / 2);

      panX = Math.min(Math.max(panX, -maxPanX), maxPanX);
      panY = Math.min(Math.max(panY, -maxPanY), maxPanY);
    }

    function updateCursor() {
      if (zoomLevel > 1.0) {
        lightboxImg.style.cursor = isDragging ? 'grabbing' : 'grab';
        lightboxImg.style.touchAction = 'none';
      } else {
        lightboxImg.style.cursor = 'zoom-in';
        lightboxImg.style.touchAction = 'auto';
      }
    }

    function updateZoomUI(withTransition = false) {
      clampPan();
      applyTransform(withTransition);
      updateCursor();

      if (zoomLevelEl) {
        zoomLevelEl.textContent = `${Math.round(zoomLevel * 100)}%`;
      }

      if (zoomInBtn) (zoomInBtn as HTMLButtonElement).disabled = zoomLevel >= MAX_ZOOM;
      if (zoomOutBtn) (zoomOutBtn as HTMLButtonElement).disabled = zoomLevel <= MIN_ZOOM;
      if (zoomResetBtn) (zoomResetBtn as HTMLButtonElement).disabled = zoomLevel === 1.0;
    }

    function resetZoom(withTransition = false) {
      zoomLevel = 1.0;
      panX = 0;
      panY = 0;
      updateZoomUI(withTransition);
    }

    function zoomTo(newZoom: number, withTransition = false) {
      zoomLevel = Math.min(Math.max(newZoom, MIN_ZOOM), MAX_ZOOM);
      if (zoomLevel === 1.0) {
        panX = 0;
        panY = 0;
      }
      updateZoomUI(withTransition);
    }

    function openLightbox(index: number) {
      currentIndex = index;

      // Reset zoom state values instantly without animations
      zoomLevel = 1.0;
      panX = 0;
      panY = 0;

      if (zoomLevelEl) zoomLevelEl.textContent = '100%';
      if (zoomInBtn) (zoomInBtn as HTMLButtonElement).disabled = false;
      if (zoomOutBtn) (zoomOutBtn as HTMLButtonElement).disabled = true;
      if (zoomResetBtn) (zoomResetBtn as HTMLButtonElement).disabled = true;
      lightboxImg.style.cursor = 'zoom-in';
      lightboxImg.style.touchAction = 'auto';

      // Keep image invisible initially
      lightboxImg.style.transition = 'none';
      lightboxImg.style.opacity = '0';
      lightboxImg.style.transform = 'scale(0.95) translate3d(0, 0, 0)';

      let loadTriggered = false;
      lightboxImg.onload = () => {
        loadTriggered = true;
        // Fade in
        lightboxImg.style.transition =
          'opacity 0.25s cubic-bezier(0.25, 1, 0.5, 1), transform 0.25s cubic-bezier(0.25, 1, 0.5, 1)';
        lightboxImg.style.opacity = '1';
        lightboxImg.style.transform = 'scale(1) translate3d(0, 0, 0)';
        lightboxImg.onload = null;
      };

      // Set src
      lightboxImg.src = imgList[currentIndex];

      // Fallback in case onload doesn't trigger
      setTimeout(() => {
        if (!loadTriggered) {
          lightboxImg.style.transition =
            'opacity 0.25s cubic-bezier(0.25, 1, 0.5, 1), transform 0.25s cubic-bezier(0.25, 1, 0.5, 1)';
          lightboxImg.style.opacity = '1';
          lightboxImg.style.transform = 'scale(1) translate3d(0, 0, 0)';
        }
      }, 250);

      updateLightboxUI();

      // Show lightbox overlay
      lightboxEl.classList.remove('pointer-events-none', 'opacity-0');
      lightboxEl.classList.add('opacity-100');

      // Disable page scrolling
      document.body.style.overflow = 'hidden';
      const scrollContainer = document.querySelector('.overflow-y-auto');
      if (scrollContainer) {
        scrollContainer.classList.remove('overflow-y-auto');
        scrollContainer.classList.add('overflow-hidden');
      }
    }

    function closeLightbox() {
      // Hide active image first to make close anim smoother
      lightboxImg.style.transition =
        'opacity 0.25s cubic-bezier(0.25, 1, 0.5, 1), transform 0.25s cubic-bezier(0.25, 1, 0.5, 1)';
      lightboxImg.style.opacity = '0';
      lightboxImg.style.transform = 'scale(0.95) translate3d(0, 0, 0)';

      // Hide lightbox overlay
      setTimeout(() => {
        lightboxEl.classList.remove('opacity-100');
        lightboxEl.classList.add('pointer-events-none', 'opacity-0');
        // Reset zoom variables after hidden
        zoomLevel = 1.0;
        panX = 0;
        panY = 0;
      }, 200);

      // Re-enable page scrolling
      document.body.style.overflow = '';
      const scrollContainer = document.querySelector('.overflow-hidden');
      if (scrollContainer) {
        scrollContainer.classList.remove('overflow-hidden');
        scrollContainer.classList.add('overflow-y-auto');
      }
    }

    function changeImage(nextIndex: number) {
      if (imgList.length <= 1) return;

      // Step 1: Smoothly fade out current image and zoom/pan back to 0.95 scale center
      lightboxImg.style.transition =
        'opacity 0.25s cubic-bezier(0.25, 1, 0.5, 1), transform 0.25s cubic-bezier(0.25, 1, 0.5, 1)';
      lightboxImg.style.opacity = '0';
      lightboxImg.style.transform = 'scale(0.95) translate3d(0, 0, 0)';

      // Wait for fade-out to finish
      setTimeout(() => {
        currentIndex = nextIndex;

        // Reset zoom values instantly (no animation) so the new image starts centered at 1x
        zoomLevel = 1.0;
        panX = 0;
        panY = 0;

        if (zoomLevelEl) zoomLevelEl.textContent = '100%';
        if (zoomInBtn) (zoomInBtn as HTMLButtonElement).disabled = false;
        if (zoomOutBtn) (zoomOutBtn as HTMLButtonElement).disabled = true;
        if (zoomResetBtn) (zoomResetBtn as HTMLButtonElement).disabled = true;
        lightboxImg.style.cursor = 'zoom-in';
        lightboxImg.style.touchAction = 'auto';

        let loadTriggered = false;
        lightboxImg.onload = () => {
          loadTriggered = true;
          // Step 2: Smoothly fade in new image
          lightboxImg.style.transition =
            'opacity 0.25s cubic-bezier(0.25, 1, 0.5, 1), transform 0.25s cubic-bezier(0.25, 1, 0.5, 1)';
          lightboxImg.style.opacity = '1';
          lightboxImg.style.transform = 'scale(1) translate3d(0, 0, 0)';
          lightboxImg.onload = null;
        };

        // Update target src
        lightboxImg.src = imgList[currentIndex];

        // Fallback in case onload is bypassed/cached and delayed
        setTimeout(() => {
          if (!loadTriggered) {
            lightboxImg.style.transition =
              'opacity 0.25s cubic-bezier(0.25, 1, 0.5, 1), transform 0.25s cubic-bezier(0.25, 1, 0.5, 1)';
            lightboxImg.style.opacity = '1';
            lightboxImg.style.transform = 'scale(1) translate3d(0, 0, 0)';
          }
        }, 220);

        updateLightboxUI();
      }, 250);
    }

    function showNext() {
      const nextIndex = (currentIndex + 1) % imgList.length;
      changeImage(nextIndex);
    }

    function showPrev() {
      const nextIndex = (currentIndex - 1 + imgList.length) % imgList.length;
      changeImage(nextIndex);
    }

    function updateLightboxUI() {
      if (lightboxCounter) {
        lightboxCounter.textContent = `Image ${currentIndex + 1} of ${imgList.length}`;
      }

      // Hide navigation arrows if only 1 image exists
      if (imgList.length <= 1) {
        if (lightboxPrev) (lightboxPrev as HTMLElement).style.display = 'none';
        if (lightboxNext) (lightboxNext as HTMLElement).style.display = 'none';
        if (lightboxCounter) lightboxCounter.style.display = 'none';
      } else {
        if (lightboxPrev) (lightboxPrev as HTMLElement).style.display = 'flex';
        if (lightboxNext) (lightboxNext as HTMLElement).style.display = 'flex';
        if (lightboxCounter) lightboxCounter.style.display = 'block';
      }
    }

    // Attach click events on triggers
    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        openLightbox(index);
      });
    });

    // Close button click
    lightboxClose?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeLightbox();
    });

    // Prev/Next click
    lightboxPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      showPrev();
    });
    lightboxNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      showNext();
    });

    // Zoom Buttons Events
    zoomInBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      zoomTo(zoomLevel + ZOOM_STEP, true);
    });

    zoomOutBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      zoomTo(zoomLevel - ZOOM_STEP, true);
    });

    zoomResetBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      resetZoom(true);
    });

    // Mouse Actions for Panning
    lightboxImg.addEventListener('mousedown', (e) => {
      if (zoomLevel <= 1.0) return;
      e.preventDefault();
      isDragging = true;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
      updateCursor();
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      updateZoomUI(false);
    });

    document.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        updateCursor();
      }
    });

    // Wheel Zoom with focal point zoom direction
    lightboxImg.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();

        const delta = -e.deltaY;
        const scaleChange = delta > 0 ? 0.25 : -0.25;
        const newZoom = zoomLevel + scaleChange;

        // Find focal point relative to the image center
        const rect = lightboxImg.getBoundingClientRect();
        const mouseX = e.clientX - rect.left - rect.width / 2;
        const mouseY = e.clientY - rect.top - rect.height / 2;

        const oldZoom = zoomLevel;
        zoomLevel = Math.min(Math.max(newZoom, MIN_ZOOM), MAX_ZOOM);

        if (zoomLevel > MIN_ZOOM && oldZoom !== zoomLevel) {
          const zoomRatio = zoomLevel / oldZoom;
          panX = panX - mouseX * (zoomRatio - 1);
          panY = panY - mouseY * (zoomRatio - 1);
        } else if (zoomLevel === MIN_ZOOM) {
          panX = 0;
          panY = 0;
        }

        updateZoomUI(false);
      },
      { passive: false },
    );

    // Double Click to Toggle Zoom (1x <=> 2.5x)
    lightboxImg.addEventListener('dblclick', (e) => {
      if (zoomLevel > 1.0) {
        resetZoom(true);
      } else {
        // Zoom specifically towards the double-click position
        const rect = lightboxImg.getBoundingClientRect();
        const mouseX = e.clientX - rect.left - rect.width / 2;
        const mouseY = e.clientY - rect.top - rect.height / 2;

        zoomLevel = 2.5;
        panX = -mouseX * (2.5 - 1);
        panY = -mouseY * (2.5 - 1);

        updateZoomUI(true);
      }
    });

    // Touch Support for Panning
    let touchStartX = 0;
    let touchStartY = 0;

    lightboxImg.addEventListener(
      'touchstart',
      (e) => {
        if (zoomLevel <= 1.0) return;
        if (e.touches.length === 1) {
          isDragging = true;
          touchStartX = e.touches[0].clientX - panX;
          touchStartY = e.touches[0].clientY - panY;
        }
      },
      { passive: true },
    );

    lightboxImg.addEventListener(
      'touchmove',
      (e) => {
        if (!isDragging) return;
        if (e.touches.length === 1) {
          panX = e.touches[0].clientX - touchStartX;
          panY = e.touches[0].clientY - touchStartY;
          updateZoomUI(false);
        }
      },
      { passive: true },
    );

    lightboxImg.addEventListener('touchend', () => {
      isDragging = false;
      updateCursor();
    });

    // Backdrop click (closing if click is directly on the background layers)
    lightboxEl.addEventListener('click', (e) => {
      // Avoid closing when dragging zoom panel or buttons
      const clickedEl = e.target as HTMLElement;

      // If clicking inside the zoom panel or navigation arrows or the image itself, don't close.
      if (
        clickedEl.closest('#lightbox-zoom-panel') ||
        clickedEl.closest('#lightbox-prev') ||
        clickedEl.closest('#lightbox-next') ||
        clickedEl.closest('#lightbox-img') ||
        clickedEl.closest('#lightbox-close')
      ) {
        return;
      }

      closeLightbox();
    });

    // Keyboard bindings
    keydownHandler = (e: KeyboardEvent) => {
      if (lightboxEl.classList.contains('pointer-events-none')) return;
      if (e.key === 'Escape') {
        closeLightbox();
      } else if (e.key === 'ArrowRight') {
        showNext();
      } else if (e.key === 'ArrowLeft') {
        showPrev();
      }
    };
    document.addEventListener('keydown', keydownHandler);
  }

  // Load lightbox on first load & after view transition swap
  document.addEventListener('astro:page-load', initLightbox);

  // Clean up global scroll styles when page changes via View Transitions
  document.addEventListener('astro:before-preparation', () => {
    document.body.style.overflow = '';
    const scrollContainer = document.querySelector('.overflow-hidden');
    if (scrollContainer) {
      scrollContainer.classList.remove('overflow-hidden');
      scrollContainer.classList.add('overflow-y-auto');
    }
  });
</script>
