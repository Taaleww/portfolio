---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import circleDraw from '../../assets/circle-draw.svg';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import Contact from '../../components/Contact.astro';
import ProjectCard from '../../components/ProjectCard';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { Content } = await project.render();
const {
  title,
  description,
  image,
  liveUrl,
  repoUrl,
  techStack,
  client,
  service,
  challenges,
  solutions,
  outcome,
  heroMockup,
  overviewImage,
  otherImages,
} = project.data;

// Get all projects to display in "Other Projects" section
const allProjects = await getCollection('projects');
const otherProjects = allProjects
  .filter((p) => p.slug !== project.slug)
  .sort((a, b) => b.data.order - a.data.order)
  .slice(0, 2);
---

<ProjectLayout title={`${title} | Project Details`}>
  <div
    class='bg-white rounded-[16px] md:rounded-[24px] font-sans text-black max-h-[calc(100dvh-90px)] md:max-h-[calc(100dvh-40px)]'
  >
    <article class='pt-10 md:pt-[120px] max-w-[1200px] mx-4 md:mx-10 lg:mx-auto' style='box-sizing: content-box;'>
      <!-- Project Hero Section -->
      <section class='flex flex-col md:flex-row gap-[40px] md:gap-[100px] items-start'>
        <div class='font-normal w-full md:max-w-[500px]' data-animate='fade-up'>
          <h1
            class='font-script text-[32px] md:text-[56px] font-normal tracking-tight leading-[140%] mb-[10px]'
            style='letter- spacing: 1%;'
          >
            {title}
          </h1>
          <p class='text-lg md:text-xl leading-[140%] max-w-xl font-normal mb-[60px]'>
            {description}
          </p>
          <a
            href={liveUrl}
            target='_blank'
            rel='noopener noreferrer'
            class='group inline-flex items-center text-black font-normal text-[18px] transition-all duration-300'
          >
            <div class='relative flex items-center gap-2 pb-1'>
              <span>Launch the site</span>
              <svg
                class='transition-transform duration-300 group-hover:translate-x-[3px] group-hover:-translate-y-[3px]'
                width='20'
                height='20'
                viewBox='0 0 20 20'
                fill='none'
                xmlns='http://www.w3.org/2000/svg'
              >
                <path
                  d='M15 5H6.90625C6.74049 5 6.58152 4.93415 6.46431 4.81694C6.3471 4.69973 6.28125 4.54076 6.28125 4.375C6.28125 4.20924 6.3471 4.05027 6.46431 3.93306C6.58152 3.81585 6.74049 3.75 6.90625 3.75H15.625C15.7908 3.75 15.9497 3.81585 16.0669 3.93306C16.1842 4.05027 16.25 4.20924 16.25 4.375V13.125C16.25 13.2908 16.1842 13.4497 16.0669 13.5669C15.9497 13.6842 15.7908 13.75 15.625 13.75C15.4592 13.75 15.3003 13.6842 15.1831 13.5669C15.0658 13.4497 15 13.2908 15 13.125V5Z'
                  fill='black'></path>
                <path
                  d='M15.1817 3.93169C15.2993 3.81411 15.4588 3.74805 15.6251 3.74805C15.7913 3.74805 15.9508 3.81411 16.0684 3.93169C16.186 4.04928 16.2521 4.20876 16.2521 4.37505C16.2521 4.54134 16.186 4.70082 16.0684 4.81841L5.44341 15.4434C5.32583 15.561 5.16634 15.6271 5.00005 15.6271C4.83376 15.6271 4.67428 15.561 4.55669 15.4434C4.43911 15.3258 4.37305 15.1663 4.37305 15.0001C4.37305 14.8338 4.43911 14.6743 4.55669 14.5567L15.1817 3.93169Z'
                  fill='black'></path>
              </svg>
              <div class='absolute bottom-0 left-0 w-[calc(100%-28px)] h-[2px] bg-black transition-all duration-300'>
              </div>
            </div>
          </a>
        </div>

        <!-- Hero Mockup (Laptop) -->
        <div class='relative' data-animate='fade-up' data-delay='200'>
          <div
            class='rounded-[32px] overflow-hidden bg-gray-200 aspect-[4/3] w-full h-full lg:w-[600px] lg:h-[450px]'
            style='box-shadow: 0px 0px 10px 0px #00000040; border: 4px solid #FFFFFF'
          >
            {
              heroMockup ? (
                <Image src={heroMockup} alt={`${title} Mockup`} class='w-full h-full object-cover' />
              ) : (
                <Image src={image as any} alt={title} class='w-full h-full object-cover' />
              )
            }
          </div>
        </div>
      </section>

      <!-- Divider -->
      <hr
        class='border-0 h-[1px] my-10'
        style='background-image: linear-gradient(to right, #C8C8C8 50%, transparent 50%); background-size: 12px 1px; background-repeat: repeat-x;'
        data-animate='fade-up'
      />

      <!-- About Project Section -->
      <section class='flex flex-col md:flex-row justify-between gap-6 md:gap-[120px] mb-[60px]' data-animate='fade-up'>
        <h2
          class='text-[32px] md:text-[48px] mt-[-16px] font-normal font-script relative inline-block leading-[140%] min-w-[204px]'
        >
          <span class='relative inline-block'>
            <span class='relative z-10'>About project</span>
            <!-- Hand-drawn Teal Loop -->
            <Image
              src={circleDraw}
              alt='circle draw'
              class='absolute top-1/2 left-1/2 w-[100%] min-w-[120px] h-auto max-w-none -translate-x-1/2 -translate-y-1/2 -z-0 pointer-events-none'
            />
          </span>
        </h2>
        <div class='grid grid-cols-1 md:grid-cols-2 gap-8 max-w-[600px] md:w-full'>
          <div>
            <h4 class='text-[18px] font-normal mb-[6px]'>Client</h4>
            <p class='text-[16px] font-normal text-[#A6A6A6]'>
              {client || '-'}
            </p>
          </div>
          <div>
            <h4 class='text-[18px] font-normal mb-[6px]'>Service</h4>
            <p class='text-[16px] font-normal text-[#A6A6A6]' set:html={service || '-'} />
          </div>
        </div>
      </section>

      <!-- Large overview image section -->
      {
        overviewImage && (
          <section class='mb-[60px] md:mb-[100px]' data-animate='scale-up'>
            <div class='rounded-[16px] md:rounded-[16px] bg-white shadow-sm overflow-hidden'>
              <Image src={overviewImage as any} alt='Desktop Screen' class='w-full' />
            </div>
          </section>
        )
      }

      <!-- Overview Project Section -->
      <section class='grid grid-cols-1 lg:grid-cols-12 gap-6 mb-[60px] md:mb-[100px]'>
        <div class='lg:col-span-6' data-animate='fade-up'>
          <h2
            class='text-[32px] md:text-[48px] mt-[-16px] font-normal font-script relative inline-block leading-[140%] min-w-[204px]'
          >
            <span class='relative inline-block'>
              <span class='relative z-10'>Overview project</span>
              <!-- Hand-drawn Teal Loop -->
              <Image
                src={circleDraw}
                alt='circle draw'
                class='absolute top-1/2 left-1/2 w-[100%] min-w-[120px] h-auto max-w-none -translate-x-1/2 -translate-y-1/2 -z-0 pointer-events-none'
              />
            </span>
          </h2>
        </div>
        <div class='lg:col-span-6' data-animate='fade-up' data-delay='100'>
          {
            challenges && (
              <div data-animate='fade-up'>
                <h3 class='text-[18px] md:text-[20px] font-normal mb-4'>Challenges</h3>
                <p
                  class='text-[16px] md:text-[18px] text-[#A6A6A6] font-normal leading-[160%] '
                  set:html={challenges}
                />
              </div>
            )
          }
          <hr class='border-t border-[#F3F3F3] my-[28px] md:my-[40px]' data-animate='fade-up' />
          {
            solutions && (
              <div data-animate='fade-up' data-delay='100'>
                <h3 class='text-[18px] md:text-[20px] font-normal mb-4'>Solutions</h3>
                <p class='text-[16px] md:text-[18px] text-[#A6A6A6] font-normal leading-[160%]' set:html={solutions} />
              </div>
            )
          }
          <hr class='border-t border-[#F3F3F3] my-[28px] md:my-[40px]' data-animate='fade-up' />
          {
            outcome && (
              <div data-animate='fade-up' data-delay='100'>
                <h3 class='text-[18px] md:text-[20px] font-normal mb-4'>Outcome</h3>
                <p class='text-[16px] md:text-[18px] text-[#A6A6A6] font-normal leading-[160%]' set:html={outcome} />
              </div>
            )
          }
        </div>
      </section>

      <!-- Mobile & Phone Mockups -->
      <section class='mb-[80px] md:mb-[160px]'>
        {
          otherImages && otherImages.length > 0 && (
            <div class='flex flex-col gap-6 md:gap-6'>
              {otherImages.map((mockup: any, index: number) => (
                <div data-animate='fade-up' data-delay={index % 2 === 0 ? '100' : '200'}>
                  <Image src={mockup} alt='Mobile Screen' class='rounded-[16px] md:rounded-[16px] w-full' />
                </div>
              ))}
            </div>
          )
        }
      </section>

      <!-- Other Projects Section -->
      <section class='flex flex-col lg:flex-row items-start justify-between mb-[100px]'>
        <div
          class='flex flex-col justify-between items-start mb-16 gap-[50px] min-w-[220px] mr-[60px]'
          data-animate='fade-up'
        >
          <h2
            class='text-[32px] md:text-[48px] mt-[-16px] font-normal font-script relative inline-block leading-[140%] min-w-[204px]'
          >
            <span class='relative inline-block'>
              <span class='relative z-10'>Other projects</span>
              <!-- Hand-drawn Teal Loop -->
              <Image
                src={circleDraw}
                alt='circle draw'
                class='absolute top-1/2 left-1/2 w-[100%] min-w-[120px] h-auto max-w-none -translate-x-1/2 -translate-y-1/2 -z-0 pointer-events-none'
              />
            </span>
          </h2>
          <a
            href='/portfolio/#projects'
            class='group hidden lg:inline-flex items-center text-black font-normal text-[18px] transition-all duration-300'
          >
            <div class='relative flex items-center gap-2 pb-1'>
              <span>See all project</span>
              <svg
                class='transition-transform duration-300 group-hover:translate-x-[3px] group-hover:-translate-y-[3px]'
                width='20'
                height='20'
                viewBox='0 0 20 20'
                fill='none'
                xmlns='http://www.w3.org/2000/svg'
              >
                <path
                  d='M15 5H6.90625C6.74049 5 6.58152 4.93415 6.46431 4.81694C6.3471 4.69973 6.28125 4.54076 6.28125 4.375C6.28125 4.20924 6.3471 4.05027 6.46431 3.93306C6.58152 3.81585 6.74049 3.75 6.90625 3.75H15.625C15.7908 3.75 15.9497 3.81585 16.0669 3.93306C16.1842 4.05027 16.25 4.20924 16.25 4.375V13.125C16.25 13.2908 16.1842 13.4497 16.0669 13.5669C15.9497 13.6842 15.7908 13.75 15.625 13.75C15.4592 13.75 15.3003 13.6842 15.1831 13.5669C15.0658 13.4497 15 13.2908 15 13.125V5Z'
                  fill='black'></path>
                <path
                  d='M15.1817 3.93169C15.2993 3.81411 15.4588 3.74805 15.6251 3.74805C15.7913 3.74805 15.9508 3.81411 16.0684 3.93169C16.186 4.04928 16.2521 4.20876 16.2521 4.37505C16.2521 4.54134 16.186 4.70082 16.0684 4.81841L5.44341 15.4434C5.32583 15.561 5.16634 15.6271 5.00005 15.6271C4.83376 15.6271 4.67428 15.561 4.55669 15.4434C4.43911 15.3258 4.37305 15.1663 4.37305 15.0001C4.37305 14.8338 4.43911 14.6743 4.55669 14.5567L15.1817 3.93169Z'
                  fill='black'></path>
              </svg>
              <div class='absolute bottom-0 left-0 w-[calc(100%-28px)] h-[2px] bg-black transition-all duration-300'>
              </div>
            </div>
          </a>
        </div>

        <div class='grid grid-cols-1 lg:grid-cols-2 gap-10'>
          {
            otherProjects.map((p: any, index: number) => (
              <ProjectCard
                client:visible
                slug={p.slug}
                title={p.data.title}
                category={p.data.category}
                image={p.data.image}
                animateDelay={index * 100}
                variant='related'
              />
            ))
          }
        </div>

        <a
          href='/portfolio/#projects'
          class='group lg:hidden inline-flex items-center text-black font-normal text-[18px] transition-all duration-300 mt-10'
        >
          <div class='relative flex items-center gap-2 pb-1'>
            <span>See all project</span>
            <svg
              class='transition-transform duration-300 group-hover:translate-x-[3px] group-hover:-translate-y-[3px]'
              width='20'
              height='20'
              viewBox='0 0 20 20'
              fill='none'
              xmlns='http://www.w3.org/2000/svg'
            >
              <path
                d='M15 5H6.90625C6.74049 5 6.58152 4.93415 6.46431 4.81694C6.3471 4.69973 6.28125 4.54076 6.28125 4.375C6.28125 4.20924 6.3471 4.05027 6.46431 3.93306C6.58152 3.81585 6.74049 3.75 6.90625 3.75H15.625C15.7908 3.75 15.9497 3.81585 16.0669 3.93306C16.1842 4.05027 16.25 4.20924 16.25 4.375V13.125C16.25 13.2908 16.1842 13.4497 16.0669 13.5669C15.9497 13.6842 15.7908 13.75 15.625 13.75C15.4592 13.75 15.3003 13.6842 15.1831 13.5669C15.0658 13.4497 15 13.2908 15 13.125V5Z'
                fill='black'></path>
              <path
                d='M15.1817 3.93169C15.2993 3.81411 15.4588 3.74805 15.6251 3.74805C15.7913 3.74805 15.9508 3.81411 16.0684 3.93169C16.186 4.04928 16.2521 4.20876 16.2521 4.37505C16.2521 4.54134 16.186 4.70082 16.0684 4.81841L5.44341 15.4434C5.32583 15.561 5.16634 15.6271 5.00005 15.6271C4.83376 15.6271 4.67428 15.561 4.55669 15.4434C4.43911 15.3258 4.37305 15.1663 4.37305 15.0001C4.37305 14.8338 4.43911 14.6743 4.55669 14.5567L15.1817 3.93169Z'
                fill='black'></path>
            </svg>
            <div class='absolute bottom-0 left-0 w-[calc(100%-28px)] h-[2px] bg-black transition-all duration-300'>
            </div>
          </div>
        </a>
      </section>

      <!-- Contact Footer CTA -->
      <section>
        <Contact />
      </section>
    </article>
  </div>
</ProjectLayout>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .no-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
</style>
